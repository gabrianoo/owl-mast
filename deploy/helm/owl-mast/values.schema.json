{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Owl Mast chart values",
  "type": "object",
  "additionalProperties": false,
  "required": ["backend", "frontend", "routing", "database", "postgresql", "identity"],
  "$defs": {
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository"],
      "properties": {
        "repository": {"type": "string", "minLength": 1},
        "tag": {"type": "string"},
        "digest": {"type": "string", "pattern": "^$|^sha256:[a-f0-9]{64}$"},
        "pullPolicy": {"type": "string", "enum": ["Always", "IfNotPresent", "Never"]}
      }
    },
    "pinnedImage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "digest"],
      "properties": {
        "repository": {"type": "string", "minLength": 1},
        "tag": {"type": "string"},
        "digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
        "pullPolicy": {"type": "string", "enum": ["Always", "IfNotPresent", "Never"]}
      }
    },
    "resources": {
      "type": "object",
      "required": ["requests", "limits"],
      "properties": {
        "requests": {"type": "object", "required": ["cpu", "memory"]},
        "limits": {"type": "object", "required": ["cpu", "memory"]}
      }
    },
    "httpProbe": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "periodSeconds", "failureThreshold"],
      "properties": {
        "path": {"type": "string", "pattern": "^/"},
        "periodSeconds": {"type": "integer", "minimum": 1},
        "failureThreshold": {"type": "integer", "minimum": 1}
      }
    },
    "execProbe": {
      "type": "object",
      "additionalProperties": false,
      "required": ["periodSeconds", "failureThreshold"],
      "properties": {
        "periodSeconds": {"type": "integer", "minimum": 1},
        "failureThreshold": {"type": "integer", "minimum": 1}
      }
    },
    "secretName": {"type": "string", "pattern": "^[a-z0-9]([-a-z0-9.]*[a-z0-9])?$"},
    "sslMode": {"type": "string", "enum": ["disable", "allow", "prefer", "require", "verify-ca", "verify-full"]}
  },
  "properties": {
    "nameOverride": {"type": "string"},
    "fullnameOverride": {"type": "string"},
    "commonLabels": {"type": "object", "additionalProperties": {"type": "string"}},
    "backend": {
      "type": "object",
      "additionalProperties": false,
      "required": ["image", "replicas", "containerPort", "service", "resources", "probes"],
      "properties": {
        "image": {"$ref": "#/$defs/image"},
        "replicas": {"type": "integer", "minimum": 0, "maximum": 1, "description": "Single instance accepted for the POC (AD-14)."},
        "containerPort": {"type": "integer"},
        "service": {"type": "object", "required": ["type", "port"]},
        "resources": {"$ref": "#/$defs/resources"},
        "javaToolOptions": {"type": "string"},
        "probes": {
          "type": "object",
          "additionalProperties": false,
          "required": ["startup", "liveness", "readiness"],
          "properties": {
            "startup": {"$ref": "#/$defs/httpProbe"},
            "liveness": {"$ref": "#/$defs/httpProbe"},
            "readiness": {"$ref": "#/$defs/httpProbe"}
          }
        },
        "extraEnv": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "value"],
            "properties": {
              "name": {"type": "string", "not": {"pattern": "(?i)(password|secret|token|credential)"}},
              "value": {"type": "string"}
            }
          }
        }
      }
    },
    "frontend": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "image", "replicas", "containerPort", "service", "resources", "probes"],
      "properties": {
        "enabled": {"type": "boolean"},
        "image": {"$ref": "#/$defs/image"},
        "replicas": {"type": "integer", "minimum": 0},
        "containerPort": {"type": "integer"},
        "service": {"type": "object", "required": ["type", "port"]},
        "resources": {"$ref": "#/$defs/resources"},
        "probes": {
          "type": "object",
          "additionalProperties": false,
          "required": ["readiness"],
          "properties": {"readiness": {"$ref": "#/$defs/httpProbe"}}
        }
      }
    },
    "routing": {
      "type": "object",
      "additionalProperties": false,
      "required": ["apiPathPrefix", "actuatorPathPrefix", "frontendPathPrefix", "ingress", "gateway"],
      "properties": {
        "apiPathPrefix": {"type": "string", "pattern": "^/", "maxLength": 1024},
        "actuatorPathPrefix": {"type": "string", "pattern": "^/", "maxLength": 1024},
        "frontendPathPrefix": {"type": "string", "pattern": "^/", "maxLength": 1024},
        "ingress": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled"],
          "properties": {
            "enabled": {"type": "boolean"},
            "className": {"type": "string"},
            "host": {"type": "string"},
            "annotations": {"type": "object"},
            "tls": {"type": "array"}
          }
        },
        "gateway": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled", "parentRefs"],
          "properties": {
            "enabled": {"type": "boolean"},
            "parentRefs": {
              "type": "array",
              "maxItems": 32,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["name"],
                "properties": {
                  "name": {"type": "string", "minLength": 1, "maxLength": 253},
                  "namespace": {"type": "string", "minLength": 1, "maxLength": 63, "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"},
                  "sectionName": {"type": "string", "minLength": 1, "maxLength": 253, "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?(\\.[a-z0-9]([-a-z0-9]*[a-z0-9])?)*$"},
                  "port": {"type": "integer", "minimum": 1, "maximum": 65535}
                }
              }
            },
            "hostnames": {"type": "array", "maxItems": 16, "items": {"type": "string", "minLength": 1, "maxLength": 253, "pattern": "^(\\*\\.)?[a-z0-9]([-a-z0-9]*[a-z0-9])?(\\.[a-z0-9]([-a-z0-9]*[a-z0-9])?)*$"}},
            "annotations": {"type": "object"}
          }
        }
      }
    },
    "database": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bundled", "name", "existingSecret", "external"],
      "properties": {
        "bundled": {"type": "boolean"},
        "name": {"type": "string", "pattern": "^[a-z_][a-z0-9_]*$"},
        "existingSecret": {"$ref": "#/$defs/secretName"},
        "external": {
          "type": "object",
          "additionalProperties": false,
          "required": ["host", "port", "sslMode"],
          "properties": {
            "host": {"type": "string"},
            "port": {"type": "integer", "minimum": 1, "maximum": 65535},
            "sslMode": {"$ref": "#/$defs/sslMode"}
          }
        }
      }
    },
    "postgresql": {
      "type": "object",
      "additionalProperties": false,
      "required": ["image", "adminExistingSecret", "service", "resources", "persistence", "securityContext", "probes"],
      "properties": {
        "image": {"$ref": "#/$defs/pinnedImage"},
        "adminExistingSecret": {"$ref": "#/$defs/secretName"},
        "provisionKeycloakDatabase": {"type": "boolean"},
        "service": {"type": "object", "required": ["port"]},
        "resources": {"$ref": "#/$defs/resources"},
        "persistence": {
          "type": "object",
          "additionalProperties": false,
          "required": ["storageClass", "size", "accessModes", "existingClaim"],
          "properties": {
            "storageClass": {"type": "string"},
            "size": {"type": "string", "pattern": "^[0-9]+(Mi|Gi|Ti)$"},
            "accessModes": {"type": "array", "minItems": 1, "items": {"type": "string", "enum": ["ReadWriteOnce", "ReadWriteOncePod"]}},
            "existingClaim": {"type": "string"}
          }
        },
        "securityContext": {
          "type": "object",
          "required": ["runAsUser", "runAsGroup", "fsGroup"],
          "properties": {
            "runAsUser": {"type": "integer", "minimum": 1},
            "runAsGroup": {"type": "integer", "minimum": 1},
            "fsGroup": {"type": "integer", "minimum": 1}
          }
        },
        "probes": {
          "type": "object",
          "additionalProperties": false,
          "required": ["startup", "liveness", "readiness"],
          "properties": {
            "startup": {"$ref": "#/$defs/execProbe"},
            "liveness": {"$ref": "#/$defs/execProbe"},
            "readiness": {"$ref": "#/$defs/execProbe"}
          }
        }
      }
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bundled", "realm", "external", "keycloak"],
      "properties": {
        "bundled": {"type": "boolean"},
        "realm": {"type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]*$"},
        "external": {
          "type": "object",
          "additionalProperties": false,
          "required": ["issuerUri"],
          "properties": {"issuerUri": {"type": "string"}}
        },
        "keycloak": {
          "type": "object",
          "additionalProperties": false,
          "required": ["image", "bootstrapExistingSecret", "importRealm", "database", "service", "resources", "probes"],
          "properties": {
            "image": {"$ref": "#/$defs/pinnedImage"},
            "bootstrapExistingSecret": {"$ref": "#/$defs/secretName"},
            "importRealm": {"type": "boolean"},
            "database": {
              "type": "object",
              "additionalProperties": false,
              "required": ["name", "existingSecret", "external"],
              "properties": {
                "name": {"type": "string", "pattern": "^[a-z_][a-z0-9_]*$"},
                "existingSecret": {"$ref": "#/$defs/secretName"},
                "external": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["host", "port", "sslMode"],
                  "properties": {
                    "host": {"type": "string"},
                    "port": {"type": "integer", "minimum": 1, "maximum": 65535},
                    "sslMode": {"$ref": "#/$defs/sslMode"}
                  }
                }
              }
            },
            "service": {"type": "object", "required": ["port", "managementPort"]},
            "resources": {"$ref": "#/$defs/resources"},
            "probes": {
              "type": "object",
              "additionalProperties": false,
              "required": ["startup", "liveness", "readiness"],
              "properties": {
                "startup": {"$ref": "#/$defs/execProbe"},
                "liveness": {"$ref": "#/$defs/execProbe"},
                "readiness": {"$ref": "#/$defs/execProbe"}
              }
            }
          }
        }
      }
    }
  }
}
