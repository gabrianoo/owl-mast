{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Owl Mast chart values",
  "type": "object",
  "additionalProperties": false,
  "required": ["backend", "frontend", "routing", "database", "postgresql", "identity"],
  "$defs": {
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository"],
      "properties": {
        "repository": {"type": "string", "minLength": 1},
        "tag": {"type": "string", "pattern": "^$|^[A-Za-z0-9_][A-Za-z0-9_.-]{0,127}$"},
        "digest": {"type": "string", "pattern": "^$|^sha256:[a-f0-9]{64}$"},
        "pullPolicy": {"type": "string", "enum": ["Always", "IfNotPresent", "Never"]}
      }
    },
    "pinnedImage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "digest"],
      "properties": {
        "repository": {"type": "string", "minLength": 1},
        "tag": {"type": "string"},
        "digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
        "pullPolicy": {"type": "string", "enum": ["Always", "IfNotPresent", "Never"]}
      }
    },
    "resources": {
      "type": "object",
      "required": ["requests", "limits"],
      "properties": {
        "requests": {"type": "object", "required": ["cpu", "memory"]},
        "limits": {"type": "object", "required": ["cpu", "memory"]}
      }
    },
    "httpProbe": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "periodSeconds", "failureThreshold"],
      "properties": {
        "path": {"type": "string", "pattern": "^/"},
        "periodSeconds": {"type": "integer", "minimum": 1},
        "failureThreshold": {"type": "integer", "minimum": 1},
        "timeoutSeconds": {"type": "integer", "minimum": 1}
      }
    },
    "servicePort": {"type": "integer", "minimum": 1, "maximum": 65535},
    "service": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "port"],
      "properties": {"type": {"type": "string", "enum": ["ClusterIP", "NodePort", "LoadBalancer"]}, "port": {"$ref": "#/$defs/servicePort"}}
    },
    "databaseName": {
      "type": "string",
      "pattern": "^[a-z_][a-z0-9_]*$",
      "maxLength": 63,
      "not": {"enum": ["template0", "template1"]},
      "description": "PostgreSQL identifiers are truncated to 63 bytes (NAMEDATALEN-1); a longer name would create a database the URLs never find. template0 and template1 are PostgreSQL's template databases; postgres is refused by the templates when the bundled PostgreSQL serves the database."
    },
    "execProbe": {
      "type": "object",
      "additionalProperties": false,
      "required": ["periodSeconds", "failureThreshold"],
      "properties": {
        "periodSeconds": {"type": "integer", "minimum": 1},
        "failureThreshold": {"type": "integer", "minimum": 1},
        "timeoutSeconds": {"type": "integer", "minimum": 1}
      }
    },
    "secretName": {"type": "string", "pattern": "^[a-z0-9]([-a-z0-9.]*[a-z0-9])?$"},
    "sslMode": {
      "type": "string",
      "enum": ["disable", "allow", "prefer", "require", "verify-ca", "verify-full"],
      "description": "verify-ca and verify-full are listed only so that the templates can refuse them with the reason (a schema refusal prints no explanation): they are not accepted until the chart mounts a CA trust (deferred, docs/installation.md). require encrypts the connection but does not authenticate the server."
    },
    "dnsHost": {
      "type": "string",
      "maxLength": 253,
      "pattern": "^$|^[A-Za-z0-9]([-A-Za-z0-9]*[A-Za-z0-9])?(\\.[A-Za-z0-9]([-A-Za-z0-9]*[A-Za-z0-9])?)*\\.?$",
      "description": "Bare DNS name (RFC 1123 labels separated by single dots, optional trailing dot) or IPv4 address: no port, path, query or scheme (it is spliced into JDBC/R2DBC URLs)."
    },
    "ingressHost": {
      "type": "string",
      "maxLength": 253,
      "pattern": "^$|^(\\*\\.)?[a-z0-9]([-a-z0-9]{0,61}[a-z0-9])?(\\.[a-z0-9]([-a-z0-9]{0,61}[a-z0-9])?)*$",
      "not": {"pattern": "^(0*(25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])\\.){3}0*(25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])$"},
      "description": "Lowercase DNS name, each label at most 63 characters, optional leading wildcard label. Not an IPv4 address (octets 0-255): the API server rejects one as an Ingress host. Numeric labels that are not an address, such as 999.1.1.1, are DNS names."
    },
    "annotations": {"type": "object", "additionalProperties": {"type": "string"}},
    "labels": {
      "type": "object",
      "additionalProperties": {"type": "string", "maxLength": 63, "pattern": "^(([A-Za-z0-9][-A-Za-z0-9_.]*)?[A-Za-z0-9])?$"},
      "propertyNames": {"not": {"pattern": "^(app\\.kubernetes\\.io/|helm\\.sh/)"}},
      "description": "Keys under app.kubernetes.io/ and helm.sh/ are chart-managed (selectors) and refused."
    },
    "externalPostgres": {
      "type": "object",
      "additionalProperties": false,
      "required": ["host", "port", "sslMode"],
      "properties": {
        "host": {"$ref": "#/$defs/dnsHost"},
        "port": {"type": "integer", "minimum": 1, "maximum": 65535},
        "sslMode": {"$ref": "#/$defs/sslMode"},
        "allowInsecureTransport": {"type": "boolean"}
      }
    },
    "networkPolicyPeers": {
      "type": "array",
      "items": {
        "type": "object",
        "minProperties": 1,
        "additionalProperties": false,
        "properties": {"podSelector": {"type": "object"}, "namespaceSelector": {"type": "object"}, "ipBlock": {"type": "object"}}
      }
    }
  },
  "properties": {
    "nameOverride": {"type": "string"},
    "fullnameOverride": {"type": "string"},
    "commonLabels": {"$ref": "#/$defs/labels"},
    "backend": {
      "type": "object",
      "additionalProperties": false,
      "required": ["image", "replicas", "containerPort", "service", "resources", "probes"],
      "properties": {
        "image": {"$ref": "#/$defs/image"},
        "replicas": {"type": "integer", "minimum": 0, "maximum": 1, "description": "Single instance accepted for the POC (AD-14)."},
        "containerPort": {"$ref": "#/$defs/servicePort"},
        "service": {"$ref": "#/$defs/service"},
        "resources": {"$ref": "#/$defs/resources"},
        "javaToolOptions": {
          "type": "string",
          "pattern": "^\\s*(-(Xm[sxn][0-9]+[kKmMgG]?|Xss[0-9]+[kKmMgG]?|XX:(MaxRAM|MaxMetaspaceSize|MetaspaceSize|MaxDirectMemorySize|ReservedCodeCacheSize|G1HeapRegionSize|SoftMaxHeapSize|MaxNewSize|NewSize)=[0-9]+[kKmMgG]?|XX:(MaxRAMPercentage|InitialRAMPercentage|MinRAMPercentage)=[0-9]+(\\.[0-9]+)?|XX:(ActiveProcessorCount|MaxHeapFreeRatio|MinHeapFreeRatio|MaxGCPauseMillis|ParallelGCThreads|ConcGCThreads|InitiatingHeapOccupancyPercent|NewRatio|SurvivorRatio|TieredStopAtLevel)=[0-9]+|XX:[+-](UseG1GC|UseZGC|UseSerialGC|UseParallelGC|UseShenandoahGC|UseContainerSupport|UseStringDeduplication|AlwaysPreTouch|ExitOnOutOfMemoryError|UseCompressedOops|UseCompressedClassPointers|TieredCompilation|DisableExplicitGC|UseNUMA))(\\s+|$))*$",
          "description": "A named allow-list of JVM memory and tuning options (-Xms/-Xmx/-Xmn/-Xss and the -XX options listed in values.yaml), each with the value form the JVM takes: sizes a whole number with an optional k/m/g, percentages a number without a suffix, counts a whole number. System properties (-D), agents, argument files and every other -XX option (file-loading, hook and attach options) are refused: they would override or bypass the chart-validated configuration."
        },
        "probes": {
          "type": "object",
          "additionalProperties": false,
          "required": ["startup", "liveness", "readiness"],
          "properties": {
            "startup": {"$ref": "#/$defs/httpProbe"},
            "liveness": {"$ref": "#/$defs/httpProbe"},
            "readiness": {
              "allOf": [
                {"$ref": "#/$defs/httpProbe"},
                {
                  "properties": {"periodSeconds": {"minimum": 6}},
                  "description": "Greater than 5 s, the interval (counted from the start of the discovery request) for which the backend keeps its identity readiness result."
                }
              ]
            }
          }
        },
        "extraEnv": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "value"],
            "properties": {
              "name": {
                "type": "string",
                "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
                "not": {
                  "anyOf": [
                    {"pattern": "(?i)(password|secret|token|credential)"},
                    {"pattern": "(?i)^(OWLMAST_|SPRING_|MANAGEMENT_|SERVER_|LOADER_|LD_)"},
                    {
                      "pattern": "(?i)^(JAVA_TOOL_OPTIONS|JDK_JAVA_OPTIONS|_JAVA_OPTIONS|JAVA_OPTS|JAVA_HOME|PATH|CLASSPATH)$"
                    }
                  ]
                },
                "description": "Plain variables only: no credentials, and nothing that overrides the chart-validated OWLMAST_/SPRING_/MANAGEMENT_/SERVER_ configuration, the Spring Boot launcher (LOADER_*), the JVM options or the dynamic loader (every LD_* variable)."
              },
              "value": {"type": "string"}
            }
          }
        }
      }
    },
    "frontend": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "image", "replicas", "containerPort", "service", "resources", "probes"],
      "properties": {
        "enabled": {"type": "boolean"},
        "image": {"$ref": "#/$defs/image"},
        "replicas": {"type": "integer", "minimum": 0},
        "containerPort": {"$ref": "#/$defs/servicePort"},
        "service": {"$ref": "#/$defs/service"},
        "resources": {"$ref": "#/$defs/resources"},
        "probes": {
          "type": "object",
          "additionalProperties": false,
          "required": ["readiness"],
          "properties": {"liveness": {"$ref": "#/$defs/httpProbe"}, "readiness": {"$ref": "#/$defs/httpProbe"}}
        }
      }
    },
    "routing": {
      "type": "object",
      "additionalProperties": false,
      "required": ["apiPathPrefix", "actuatorPathPrefix", "frontendPathPrefix", "ingress", "gateway"],
      "properties": {
        "apiPathPrefix": {"type": "string", "pattern": "^/", "maxLength": 1024},
        "actuatorPathPrefix": {"type": "string", "pattern": "^/", "maxLength": 1024},
        "frontendPathPrefix": {"type": "string", "pattern": "^/", "maxLength": 1024},
        "exposeActuator": {"type": "boolean"},
        "ingress": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled"],
          "properties": {
            "enabled": {"type": "boolean"},
            "className": {"type": "string"},
            "host": {"$ref": "#/$defs/ingressHost"},
            "annotations": {"$ref": "#/$defs/annotations"},
            "tls": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["hosts", "secretName"],
                "properties": {
                  "hosts": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/ingressHost"}},
                  "secretName": {"$ref": "#/$defs/secretName"}
                }
              }
            }
          }
        },
        "gateway": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled", "parentRefs"],
          "properties": {
            "enabled": {"type": "boolean"},
            "parentRefs": {
              "type": "array",
              "maxItems": 32,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["name"],
                "properties": {
                  "name": {"type": "string", "minLength": 1, "maxLength": 253},
                  "namespace": {"type": "string", "minLength": 1, "maxLength": 63, "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"},
                  "sectionName": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 253,
                    "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?(\\.[a-z0-9]([-a-z0-9]*[a-z0-9])?)*$"
                  },
                  "port": {"type": "integer", "minimum": 1, "maximum": 65535}
                }
              }
            },
            "hostnames": {
              "type": "array",
              "maxItems": 16,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 253,
                "pattern": "^(\\*\\.)?[a-z0-9]([-a-z0-9]*[a-z0-9])?(\\.[a-z0-9]([-a-z0-9]*[a-z0-9])?)*$",
                "not": {"pattern": "^(0*(25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])\\.){3}0*(25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])$"}
              }
            },
            "allowAllListenerHostnames": {"type": "boolean"},
            "annotations": {"$ref": "#/$defs/annotations"}
          }
        }
      }
    },
    "database": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bundled", "name", "existingSecret", "external"],
      "properties": {
        "bundled": {"type": "boolean"},
        "name": {"$ref": "#/$defs/databaseName"},
        "existingSecret": {"$ref": "#/$defs/secretName"},
        "external": {"$ref": "#/$defs/externalPostgres"}
      }
    },
    "postgresql": {
      "type": "object",
      "additionalProperties": false,
      "required": ["image", "adminExistingSecret", "service", "resources", "persistence", "securityContext", "probes"],
      "properties": {
        "image": {"$ref": "#/$defs/pinnedImage"},
        "adminExistingSecret": {"$ref": "#/$defs/secretName"},
        "provisionKeycloakDatabase": {"type": "boolean"},
        "service": {"type": "object", "additionalProperties": false, "required": ["port"], "properties": {"port": {"$ref": "#/$defs/servicePort"}}},
        "resources": {"$ref": "#/$defs/resources"},
        "persistence": {
          "type": "object",
          "additionalProperties": false,
          "required": ["storageClass", "size", "accessModes", "existingClaim"],
          "properties": {
            "storageClass": {"type": "string"},
            "size": {"type": "string", "pattern": "^[0-9]+(Mi|Gi|Ti)$"},
            "accessModes": {"type": "array", "minItems": 1, "items": {"type": "string", "enum": ["ReadWriteOnce", "ReadWriteOncePod"]}},
            "existingClaim": {"type": "string"}
          }
        },
        "securityContext": {
          "type": "object",
          "required": ["runAsUser", "runAsGroup", "fsGroup"],
          "properties": {
            "runAsUser": {"type": "integer", "minimum": 1},
            "runAsGroup": {"type": "integer", "minimum": 1},
            "fsGroup": {"type": "integer", "minimum": 1}
          }
        },
        "probes": {
          "type": "object",
          "additionalProperties": false,
          "required": ["startup", "liveness", "readiness"],
          "properties": {
            "startup": {"$ref": "#/$defs/execProbe"},
            "liveness": {"$ref": "#/$defs/execProbe"},
            "readiness": {"$ref": "#/$defs/execProbe"}
          }
        }
      }
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bundled", "realm", "external", "keycloak"],
      "properties": {
        "bundled": {"type": "boolean"},
        "realm": {"type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]*$"},
        "external": {
          "type": "object",
          "additionalProperties": false,
          "required": ["issuerUri"],
          "properties": {"issuerUri": {"type": "string"}, "allowInsecureIssuer": {"type": "boolean"}}
        },
        "keycloak": {
          "type": "object",
          "additionalProperties": false,
          "required": ["image", "bootstrapExistingSecret", "importRealm", "database", "service", "resources", "probes"],
          "properties": {
            "image": {"$ref": "#/$defs/pinnedImage"},
            "bootstrapExistingSecret": {
              "type": "string",
              "pattern": "^$|^[a-z0-9]([-a-z0-9.]*[a-z0-9])?$",
              "description": "Required while bootstrapAdmin.enabled is true (the templates refuse an empty value then); may be empty once the bootstrap admin is retired."
            },
            "bootstrapAdmin": {
              "type": "object",
              "additionalProperties": false,
              "required": ["enabled"],
              "properties": {"enabled": {"type": "boolean"}}
            },
            "importRealm": {"type": "boolean"},
            "database": {
              "type": "object",
              "additionalProperties": false,
              "required": ["name", "existingSecret", "external"],
              "properties": {
                "name": {"$ref": "#/$defs/databaseName"},
                "existingSecret": {"$ref": "#/$defs/secretName"},
                "external": {"$ref": "#/$defs/externalPostgres"}
              }
            },
            "service": {
              "type": "object",
              "additionalProperties": false,
              "required": ["port", "managementPort"],
              "properties": {"port": {"$ref": "#/$defs/servicePort"}, "managementPort": {"$ref": "#/$defs/servicePort"}}
            },
            "resources": {"$ref": "#/$defs/resources"},
            "probes": {
              "type": "object",
              "additionalProperties": false,
              "required": ["startup", "liveness", "readiness"],
              "properties": {
                "startup": {"$ref": "#/$defs/execProbe"},
                "liveness": {"$ref": "#/$defs/execProbe"},
                "readiness": {"$ref": "#/$defs/execProbe"}
              }
            },
            "realmManagedByOperator": {"type": "boolean"},
            "proxyHeaders": {"type": "string", "enum": ["", "xforwarded", "forwarded"]}
          }
        }
      }
    },
    "networkPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled"],
      "properties": {
        "enabled": {"type": "boolean"},
        "postgresql": {
          "type": "object",
          "additionalProperties": false,
          "properties": {"extraFrom": {"$ref": "#/$defs/networkPolicyPeers"}}
        },
        "keycloak": {
          "type": "object",
          "additionalProperties": false,
          "properties": {"extraFrom": {"$ref": "#/$defs/networkPolicyPeers"}}
        }
      }
    }
  }
}
